---
import LegalPageShell from '../../components/legal/LegalPageShell.astro'
import { LEGAL_CONTACT_EMAIL } from '../../lib/legalNav'

const path = '/legal/contact'
const mailto = `mailto:${LEGAL_CONTACT_EMAIL}`
---

<LegalPageShell
  path={path}
  breadcrumb="Contact"
  pageType="ContactPage"
  headline="Contact the maintainer"
  dek="This site does not use contact forms or ticket systems. For anything specific to roadtovostok.net—guide corrections, permission questions, or privacy requests—use the email address below."
  dekFollow="You can write in English or Chinese; either is fine as long as the technical details are clear."
>
  <section class="legal-section section" aria-labelledby="contact-email">
    <div class="container">
      <div class="wrap wrap--wide">
        <h2 id="contact-email" class="section-heading">Email address</h2>
        <p class="legal-prose">
          <a class="email-link" href={mailto}>{LEGAL_CONTACT_EMAIL}</a>
        </p>
        <p class="legal-prose">
          Use a descriptive subject line (for example “Map pin correction” or “Privacy request”) so messages are easier to
          triage. We do not publish a postal address or phone number for this site.
        </p>
      </div>
    </div>
  </section>

  <section class="legal-section section" aria-labelledby="contact-guides">
    <div class="container">
      <div class="wrap wrap--wide">
        <h2 id="contact-guides" class="section-heading">Reporting guide or map issues</h2>
        <p class="legal-prose">
          If a paragraph, pin description, or checklist disagrees with your game, include the exact page URL, what you expected,
          what happened instead, and your Steam build or version string. Screenshots help when the problem is UI placement or
          wording.
        </p>
        <p class="legal-prose">
          Many topics already have a natural home before you email us: the
          <a class="text-link" href="/wiki">wiki hub</a>
          for weapons, survival, traders, and crossings; the
          <a class="text-link" href="/map">world map</a>
          for spatial references; the
          <a class="text-link" href="/start">Start</a>
          page for demo vs Early Access and PC specs.
        </p>
      </div>
    </div>
  </section>

  <section class="legal-section section" aria-labelledby="contact-response">
    <div class="container">
      <div class="wrap wrap--wide">
        <h2 id="contact-response" class="section-heading">Response time</h2>
        <p class="legal-prose">
          This manual is a side project. We read mail in batches; not every message gets a personal reply, especially if the fix
          is obvious (we may just update the page). Urgent game bugs, refund issues, or account problems belong with the developer
          and Steam—not with this guide site.
        </p>
      </div>
    </div>
  </section>

  <section class="legal-section section section--tight" aria-labelledby="contact-more">
    <div class="container">
      <div class="wrap wrap--wide">
        <h2 id="contact-more" class="section-heading">Privacy and permissions</h2>
        <p class="legal-prose">
          For data-handling questions, read the
          <a class="text-link" href="/legal/privacy">Privacy policy</a>. For reuse of site text or takedown requests, see
          <a class="text-link" href="/legal/copyright">Copyright</a>.
        </p>
      </div>
    </div>
  </section>
</LegalPageShell>
