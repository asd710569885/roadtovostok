---
interface WeaponItem {
  id: string
  category?: string
  name: string
  image?: string
  weightKg?: number | string | null
  damage?: number | string | null
  caliber?: string | null
  magazine?: number | string | null
  rpm?: number | string | null
  value?: number | string | null
  cost?: number | string | null
}

interface Props {
  items: WeaponItem[]
}

const { items } = Astro.props

const baseUrl = import.meta.env.BASE_URL

const CATEGORY_ORDER = ['rifle', 'knife', 'smg', 'shotgun', 'bolt_action', 'semi_auto'] as const

const CATEGORY_LABELS: Record<string, string> = {
  rifle: 'Rifles',
  knife: 'Knives & melee',
  smg: 'SMGs & PDWs',
  shotgun: 'Shotguns',
  bolt_action: 'Bolt-action rifles',
  semi_auto: 'Semi-automatic rifles',
}

function buildGroups(rows: WeaponItem[]) {
  const byCat = new Map<string, WeaponItem[]>()
  for (const row of rows) {
    const k = row.category || 'other'
    if (!byCat.has(k)) byCat.set(k, [])
    byCat.get(k)!.push(row)
  }
  const out: { key: string; label: string; rows: WeaponItem[] }[] = []
  for (const key of CATEGORY_ORDER) {
    const groupRows = byCat.get(key)
    if (groupRows?.length) out.push({ key, label: CATEGORY_LABELS[key] || key, rows: groupRows })
    byCat.delete(key)
  }
  for (const [key, groupRows] of byCat) {
    if (groupRows.length) out.push({ key, label: CATEGORY_LABELS[key] || key, rows: groupRows })
  }
  return out
}

function cell(v: unknown) {
  if (v === null || v === undefined || v === '') return '—'
  return String(v)
}

function imgSrc(path: string) {
  if (!path) return ''
  const p = path.startsWith('/') ? path.slice(1) : path
  return `${baseUrl}${p}`
}

const groups = buildGroups(items)
---

<div class="wiki-ref">
  {
    groups.map((g) => (
      <section class="wiki-ref__panel" aria-labelledby={`wiki-ref-cat-${g.key}`}>
        <header class="wiki-ref__head">
          <div class="wiki-ref__head-text">
            <h2 id={`wiki-ref-cat-${g.key}`} class="wiki-ref__title">
              {g.label}
            </h2>
            <p class="wiki-ref__dek">Click a weapon name for the full dossier · scroll horizontally on small screens</p>
          </div>
          <span class="wiki-ref__count" aria-label={`${g.rows.length} entries`}>
            {g.rows.length}
          </span>
        </header>

        <div class="wiki-ref__table-wrap">
          <table class="wiki-ref__table">
            <thead>
              <tr>
                <th scope="col" class="wiki-ref__th wiki-ref__th--photo">
                  Photo
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--name">
                  Weapon
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--num">
                  Wt. kg
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--num">
                  Dmg
                </th>
                <th scope="col" class="wiki-ref__th">
                  Caliber
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--num">
                  Mag
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--num">
                  RPM
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--narrow">
                  Value
                </th>
                <th scope="col" class="wiki-ref__th wiki-ref__th--narrow">
                  Cost
                </th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map((w) => (
                <tr class="wiki-ref__tr">
                  <td class="wiki-ref__td wiki-ref__td--photo">
                    <div class="wiki-ref__photo">
                      {w.image ? (
                        <img
                          class="wiki-ref__img"
                          src={imgSrc(w.image)}
                          alt={w.name}
                          width="80"
                          height="52"
                          loading="lazy"
                        />
                      ) : (
                        <span class="wiki-ref__photo-ph" aria-hidden="true" />
                      )}
                    </div>
                  </td>
                  <th scope="row" class="wiki-ref__td wiki-ref__td--name">
                    <a class="wiki-ref__name-a" href={`/wiki/weapons/${w.id}`}>{w.name}</a>
                  </th>
                  <td class="wiki-ref__td wiki-ref__td--num">{cell(w.weightKg)}</td>
                  <td class="wiki-ref__td wiki-ref__td--num">{cell(w.damage)}</td>
                  <td class="wiki-ref__td wiki-ref__td--cal">{cell(w.caliber)}</td>
                  <td class="wiki-ref__td wiki-ref__td--num">{cell(w.magazine)}</td>
                  <td class="wiki-ref__td wiki-ref__td--num">{cell(w.rpm)}</td>
                  <td class="wiki-ref__td wiki-ref__td--narrow">{cell(w.value)}</td>
                  <td class="wiki-ref__td wiki-ref__td--narrow">{cell(w.cost)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <div class="wiki-ref__about" role="region" aria-labelledby="wiki-ref-intro-h">
    <div class="wiki-ref__about-accent" aria-hidden="true" />
    <h2 id="wiki-ref-intro-h" class="wiki-ref__about-title">About this reference</h2>
    <p class="wiki-ref__about-lead">
      Road to Vostok Field Manual keeps weapon data in one scannable place: grouped tables, thumbnails served
      from this site, and the same layout you'll see on our other wiki tabs (ammo, maps, NPCs). We optimize for
      quick lookup on phone or desktop—no nested article chrome.
    </p>
    <ul class="wiki-ref__about-list">
      <li>
        <span class="wiki-ref__about-dot" aria-hidden="true" />
        <span>
          <strong>Build-first mindset.</strong>
          Patch tuning can move damage, RPM, and economy. Use the HUD build string as ground truth; treat this
          table as a convenience snapshot you can compare before a run.
        </span>
      </li>
      <li>
        <span class="wiki-ref__about-dot" aria-hidden="true" />
        <span>
          <strong>Stay on the manual.</strong>
          Pair loadouts with
          <a class="wiki-ref__about-a" href="/map">the interactive map</a>,
          <a class="wiki-ref__about-a" href="/start">Start</a>
          for Demo vs EA context, and
          <a class="wiki-ref__about-a" href="/updates">Updates</a>
          when a patch drops.
        </span>
      </li>
      <li>
        <span class="wiki-ref__about-dot" aria-hidden="true" />
        <span>
          <strong>More topics.</strong>
          Jump back to the
          <a class="wiki-ref__about-a" href="/wiki">wiki index</a>
          for ammo, maps, and NPCs, or open the
          <a class="wiki-ref__about-a" href="/">home overview</a>
          for the full field manual layout.
        </span>
      </li>
    </ul>
  </div>
</div>
